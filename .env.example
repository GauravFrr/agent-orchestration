# Database Configuration
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator_pass@localhost:5432/orchestration
ANALYST_DATABASE_URL=postgresql+psycopg://analyst:analyst_pass@localhost:5432/orchestration

# Provider API Keys (Fill at least one to run real LLM queries)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default Models
DEFAULT_MODEL_GEMINI=gemini-3.6-flash
DEFAULT_MODEL_CLAUDE=claude-3-5-sonnet-latest
DEFAULT_MODEL_GROQ=llama-3.3-70b-versatile

# Set to True to run without actual LLM keys (will return mock planning and reviews)
MOCK_PROVIDERS=False
